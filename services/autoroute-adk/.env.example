# Copy to local shell / Secret Manager — never commit real values.
GOOGLE_CLOUD_PROJECT=bear-iot-asp-rec
GOOGLE_CLOUD_LOCATION=us-central1
IOT_ASP_GEMINI_ENGINE_ID=iot-asp-autoroute
IOT_ASP_VERTEX_MODEL=gemini-2.5-flash
# IOT_ASP_GCS_BUCKET=  # private bucket name only; set locally
IOT_ASP_AUTOROUTE_DRY_RUN=1
# IOT_ASP_AUTOROUTE_DRY_ROOT=  # optional override; default <repo>/.autoroute-dry
