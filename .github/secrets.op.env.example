# Dotenv template for scripts/op_secrets_to_gh.sh — references only, never values.
# Copy to .github/secrets.op.env (gitignored), fix the item titles/fields to match your
# 1Password Environment/vault `dev` (see `scripts/op_secrets_to_gh.sh discover`), then:
#   scripts/op_secrets_to_gh.sh push
# Each line: GITHUB_SECRET_NAME=op://<vault>/<item title>/<field label>
VERCEL_TOKEN=op://dev/Vercel deploy token gh-actions/credential
VERCEL_ORG_ID=op://dev/Vercel hop-ultrasonic/orgId
VERCEL_PROJECT_ID=op://dev/Vercel hop-ultrasonic/projectId
VERCEL_DEPLOY_HOOK_PROD=op://dev/Vercel deploy hook gh-actions-prod/credential
# Optional: only if Vercel Deployment Protection is on for previews
# VERCEL_AUTOMATION_BYPASS_SECRET=op://dev/Vercel hop-ultrasonic/automation bypass
